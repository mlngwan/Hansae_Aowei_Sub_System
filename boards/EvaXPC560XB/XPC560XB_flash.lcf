 /* 
  * !LINKSTO OsekCore.Platforms.Board.012, 1
  */
  
MEMORY
{
    /******************************************************************
    ********************** FLASH **************************************/
    /*
    * !LINKSTO OsekCore.Platforms.Linker.007, 1
    */
    reset               : org = 0x00000000, len = 0x00010

    /**********************************************************/
    /*Section for entry point startup code*/
    reset_code              : org = 0x00000010, len = 0x0FF0
    /*********************************************************/


    /**********************************************************/
    /*Section needed to store required data to initialize the RAL
    * ex: _copy_rom_info
    * this variable is generated automatically by the compiler*/
    init                 : org = 0x00001000, len = 0x01000
    /*********************************************************/

    /*
    * !LINKSTO OsekCore.Platforms.Linker.006, 1
    */
    exctab               : org = 0x00002000, len = 0x00800
    intctab              : org = 0x00002800, len = 0x00800

    /* 
    * !LINKSTO OsekCore.Platforms.Linker.002, 1
    */
    mtextboot            : org = 0x00003000, len = 0xC000

    /* 
    * !LINKSTO OsekCore.Platforms.Linker.008, 1
    */
    mtextflash           : org = 0x0000F000, len = 0x1000

    /* 
    * !LINKSTO OsekCore.Platforms.Linker.001, 1
    */
    mtext                : org = 0x00004000, len = 0x1000  /* end of 256 kb Flash */
  
    /******************************************************************
    ********************** RAM** **************************************/    
    /* 
    * !LINKSTO OsekCore.Platforms.Linker.009, 1
    * !LINKSTO OsekCore.Platforms.Startup.012, 1
    */
    mkernstack           : org = 0x40000000, len = 0x01000
    mkernheap            : org = 0x40001000, len = 0x00E00

    /* 
    * !LINKSTO OsekCore.Platforms.Linker.008, 1
    */
    mdataflash           : org = 0x40001E00, len = 0x00100

    /* 
    * !LINKSTO OsekCore.Platforms.Linker.003, 1
    */
    mdata                : org = 0x40001F00, len = 0x02000


    /* 
    * !LINKSTO OsekCore.Platforms.Linker.005, 1
    */
    section_noinit       : org = 0x40003F00, len = 0x00100  /* 16 KB SRAM */

}

/* This will ensure the __entry is not stripped by the linker */
FORCEACTIVE { "__entry"}


SECTIONS
{
    /****************************************************************************
    ** ROM Sections                                                           **
    ****************************************************************************/

    .reset LOAD (0x00000000) : {} > reset  /* LOAD (0x0) prevents relocation by ROM copy during startup */ 
    /* .reset contains the Reset Configuration Half Word (RCHW) and entry point */

    /*Load section to the address...see VLECODE mark*/
    .reset_code (VLECODE) LOAD (0x00000010) : {} > reset_code

    GROUP :
    {
        .init LOAD (0x00001000) : {}
        .init_vle (VLECODE) LOAD (_e_init) :
        {
            *(.init)
            *(.init_vle)
        }
    } > init

    .exctab  LOAD (0x00002000):
    {
        __EXCEPTION_TABLE_START = .;
        *(.exctab)
        __EXCEPTION_TABLE_END = .;
    } > exctab

    .intctab  LOAD (0x00002800):
    {
        __INTC_TABLE_START = .;
        *(.intctab)
        __INTC_TABLE_END = .;
    } > intctab

    GROUP ALIGN(4) :
    {
        .text (VLECODE) :
        {
            *(.text)
            *(.text_vle)
            *(.fini)
        }

        .rodata (CONST) :
        {
            *(.rdata)
            *(.rodata)
        }
      
      __DATA_ROM = .;

    .fls_driver ALIGN(4) : {} /* Function executed from RAM need to be aligned on 4 bytes imperatively. */
    __FLS_DRV_ST = . - SIZEOF(.fls_driver); 
    __FLS_DRV_SIZE = . - __FLS_DRV_ST;

        /* constructor and destructor function ptrs                 */
        .ctors : {}
        .dtors : {}
    } > mtextboot

    /* these two sections are required for the compiler */
    extab : {}
    extabindex : {}

    GROUP  ALIGN(4):
    {
        __DATA_RAM = .;
        /* With the LOAD specification, the next command will
        * reserve space for the .data section at the beginning of
        * "ram" (the "logical" address), but actually place the
        * data in the image at the end of the .text section as
        * defined by __DATA_ROM in the GROUP above (the "physical"
        * address).
        */
        .data (DATA) : {}
        .sdata  :
        {
            *(.sdata)
        }
        __DATA_END = .;

        __BSS_START = .;
        .sbss (BSS) : {}
        .bss  (BSS) : {}
        .tibss (BSS) : {}
        .sdata2 : {}
        .sbss2: {}
        __BSS_END = .;

        __HEAP_START = .;
    } > mdata

    GROUP : {
        .noinit:{}
        .noinitbss:{}
     } > section_noinit /* RAM no init */
  
    __IVPR          = __EXCEPTION_TABLE_START;
    _EXCEPTION_TABLE_START = __EXCEPTION_TABLE_START;
    _INTC_TABLE_START = __INTC_TABLE_START;
    __SP_INIT       = ADDR(mkernstack) + SIZEOF(mkernstack);
    __SP_END        = ADDR(mkernstack);
    _SP_INIT_       = __SP_INIT;
  
    _INIT_          = __DATA_ROM;
    _DATA_START_    = __DATA_RAM;
    _DATA_END_      = __DATA_END; /* This prevent the copy loop to copy anything */

    /* No Initialization SRAM section */
    __NOINIT_START  = ADDR(section_noinit);
    __NOINIT_END     = ADDR(section_noinit) + SIZEOF(section_noinit);
    __NOINIT_SIZE   = SIZEOF(section_noinit);

    _BSS_START_     = __BSS_START;
    _BSS_END_       = __BSS_END;

    ___SP_INIT      = __SP_INIT;
    ___SP_END       = __SP_END;

    ___DATA_ROM     = __DATA_ROM;
  
    /* Freescale CodeWarrior compiler address designations */
    _stack_addr = ADDR(mkernstack)+SIZEOF(mkernstack);
    _stack_end  = ADDR(mkernstack);
    _heap_addr  = ADDR(mkernheap);
    _heap_end   = ADDR(mkernheap)+SIZEOF(mkernheap);


    /* RAM to be initialized if the complete RAM sections WITHOUT RamNoInit*/
    __GLBL_RAM_START    = ADDR(mkernstack);
    __GLBL_RAM_SIZE     = SIZEOF(mkernstack) + SIZEOF(mdataflash) + SIZEOF(mdata);
    __GLBL_RAM_END      = __GLBL_RAM_START + __GLBL_RAM_SIZE;

    __GLBL_TEXT_START   = ADDR(mtextboot);

}
