/*--------------------------{UDS_ControlDTCSetting}--------------------------------------*/
/* Deviation MISRA-1 */
tUdsStatus UDS_ControlDTCSetting(u16 *puwLen, u8 *aubUdsData)
{
	u32 ulDtcCode;
	tUdsStatus eUdsStatus;


	eUdsStatus = UDS_ACK;


	/* input pointers are always checked in case of function takes NULL parameters */
	if ((puwLen != NULL) && (aubUdsData != NULL))
	{
		/* Check if all condition to execute the request are correct*/
		eUdsStatus = DEM_IsConditionCorrect(puwLen,aubUdsData);
//		eUdsStatus = DEM_ControlDTCSetting(puwLen, aubUdsData);

		if(UDS_ACK == eUdsStatus)
		{
			/* Retrieve the DTC code from UDS buffer */
			ulDtcCode = (u32)(((u32)aubUdsData[2] << 32U) & 0xFF000000U);
			ulDtcCode |= (u32)(((u32)aubUdsData[3] << 16U) & 0x00FF0000U);
			ulDtcCode |= (u32)(((u32)aubUdsData[4] << 8U) & 0x0000FF00U);
			ulDtcCode |= (u32)((u32)aubUdsData[5] & 0x000000FFU);


			/* If all the DTC shall be locked */
			if ((0x003201F4U == ulDtcCode) && ( 1U == (u8)(aubUdsData[1] & 0x7FU)))
			{
				/* start DTC detect */
				m_aubDtcActivation = DEM_MODE_ON;
				DEM_StartOperatingCycle();
			}
			/* If all the DTC shall be unlocked */
			else if ((0x003201F4U == ulDtcCode) && ( 2U == (u8)(aubUdsData[1] & 0x7FU)))
			{
				/* stop DTC detect */
				m_aubDtcActivation = DEM_MODE_OFF;
				DEM_StopOperatingCycle();
			}
			else
			{
				/* Nothing */
			}
		}
	}
	else
	{
		eUdsStatus = UDS_NRC_22;
	}
	return eUdsStatus;
}
/*--------------------------{end UDS_ControlDTCSetting}----------------------------------*/

