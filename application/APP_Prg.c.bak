/*--------------------------{APP_ComBackInd}--------------------------------------*/
void APP_ComBackInd (tComMonNodeIdx uNodeIdx)
{
	ubMissMessageTimer[uNodeIdx] = NM_COUNTER_MAX;
}
/*--------------------------{end APP_ComBackInd}----------------------------------*/

/*--------------------------{APP_ComLossInd}--------------------------------------*/
void APP_ComLossInd (tComMonNodeIdx uNodeIdx)
{
	if(ubMissMessageTimer[uNodeIdx] > 1)
	{
		ubMissMessageTimer[uNodeIdx]--;
	}
}
/*--------------------------{end APP_ComLossInd}----------------------------------*/

/*--------------------------{APP_COM_MonNodeStatusInd}--------------------------------------*/
void APP_COM_MonNodeStatusInd(tComMonNodeIdx uNodeIdx, tComMonStatus eFrameStatus)
{
	u8 ubIdx;
	u8 ubDtcIdx = 0xFFU;
	u8 aubContext[DEM_CONTEXT_SIZE];
#if 0
	switch (uNodeIdx)
	{
		case COM_NODE_IDX_MissingMessageEMS:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEEMS;
		break;
		case COM_NODE_IDX_MissingMessageTCU:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGETCU;
		break;
		case COM_NODE_IDX_MissingMessageESP02:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEESP;
		break;
		case COM_NODE_IDX_MissingMessageESP03:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEESP;
		break;
		case COM_NODE_IDX_MissingMessageESP04:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEESP;
		break;
		case COM_NODE_IDX_MissingMessageESP05:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEESP;
		break;
		case COM_NODE_IDX_MissingMessageESP09:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEESP;
		break;
		case COM_NODE_IDX_MissingMessageYRS:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEYRS;
		break;
		case COM_NODE_IDX_MissingMessageBcmCtr:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEBCM;
		break;
		case COM_NODE_IDX_MissingMessageBcmVeh:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEBCM;
		break;
		case COM_NODE_IDX_MissingMessageACU:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEACU;
		break;
		case COM_NODE_IDX_MissingMessageFIU:
			ubDtcIdx = DEM_DTC_IDX_DTC_MISSINGMESSAGEFIU;
		break;
		default:break;
	}

	if (ubDtcIdx < DEM_DTC_NUMBER)
	{
		switch (eFrameStatus)
		{
			case COM_MON_OK:
				if (ubMissMessageTimer[ubDtcIdx] > 0)
				{
					/* Signal clearance confirmation */
					DEM_DtcTestStatus(ubDtcIdx, DEM_TEST_PASS);
					ubMissMessageTimer[uNodeIdx] = NM_COUNTER_MAX;
//					DEM_SetStatusMask(ubDtcIdx, DEM_TEST_PASS);
//					DEM_DefectSnapshotFrozen
				}
				else
				{
					/* Signal Defect confirmation */
					DEM_DtcTestStatus(ubDtcIdx, DEM_TEST_FAIL);
					ubMissMessageTimer[uNodeIdx] = 0;
				}
			break;
			case COM_MON_NOK:
				if(ubMissMessageTimer[uNodeIdx] > 1)
				{
					ubMissMessageTimer[uNodeIdx]--;
				}
				else
				{
					/* Signal Defect confirmation */
					for (ubIdx = 0U; ubIdx < DEM_CONTEXT_SIZE; ubIdx++)
					{
						aubContext[ubIdx] = ubIdx;
					}
					if(DEM_MODE_ON == m_aubDtcActivation)
					{
						DEM_DefectSnapshotFrozen(ubDtcIdx,aubContext);
						DEM_DtcTestStatus(ubDtcIdx, DEM_TEST_FAIL);
					}
				}
			break;
			default:break;
		}
	}
#endif
}
/*--------------------------{end APP_COM_MonNodeStatusInd}----------------------------------*/

