/*--------------------------{IOCBI_MotorOutput}--------------------------------------*/
/* Deviation MISRA-1 */
tUdsStatus IOCBI_MotorOutput(u16 *puwLen, u8 *aubUdsData)
{
    /* Define pointer to length in callback */
    /* If nothing is implemented in callback, length returned is 0 and no response is sent */
    /* By default the callback length shall be 3 (service 1 and DID 2 ) */
    
    tUdsStatus eUdsStatus;
    eUdsStatus = UDS_ACK;
		
    /* input pointers are always checked in case of function takes NULL parameters */
    if ((puwLen != NULL) && (aubUdsData != NULL))
    {
			if(m_eSecurityState == PROG_SECURITY_STATE_UNLOCK)
    	{
				*puwLen = 5U;
				if(aubUdsData[3] == 0)
				{
					IOCBI_MotorOutput_Bit = 1;

					if(ubMotorOutput_Buf == 1)
					{
						aubUdsData[4] = 2;
						ubMotorOutput_Buf = 2;
					}
					else if(ubMotorOutput_Buf == 2)
					{
						aubUdsData[4] = 1;
						ubMotorOutput_Buf = 1;
					}
	    	}
				else if(aubUdsData[3] == 3)
				{
					IOCBI_MotorOutput_Bit = 1;

					if(aubUdsData[4] < 3)
					{
						ubMotorOutput_Buf = aubUdsData[4];							// Stop = 0, Apply = 1, Release = 2
					}
					else
					{
						IOCBI_MotorOutput_Bit = 0;
						eUdsStatus = UDS_NRC_22;				// Conditions not correct
					}
				}
				else
				{
					IOCBI_BrakLightReq_Bit = 0;
					eUdsStatus = UDS_NRC_22;				// Conditions not correct
				}
			}
			else
			{
				eUdsStatus = UDS_NRC_33;					// Security Acces Denied
			}
    }
    else
    {
        eUdsStatus = UDS_NRC_13;					// Incorrect Message Length or Invalid Format
    }

    return eUdsStatus;
}
/*--------------------------{end IOCBI_MotorOutput}----------------------------------*/

