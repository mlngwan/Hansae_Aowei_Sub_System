/*--------------------------{EraeMemoryTest}--------------------------------------*/
/* Deviation MISRA-1 */


tUdsStatus EraeMemoryTest(u16 *puwLen, u8 *aubUdsData)
{
	tUdsStatus eUdsStatus = UDS_ACK;

	BootWriteAdd[0] = aubUdsData[9];
	BootWriteAdd[1] = aubUdsData[10];
	BootWriteAdd[2] = aubUdsData[11];
	BootWriteAdd[3] = aubUdsData[12];

	eUdsStatus = UDS_NRC_78;

	if(((aubUdsData[5] == 0x00) && (aubUdsData[6] == 0x01) && (aubUdsData[7] == 0x80) && (aubUdsData[8] == 0x00)))
	{
		eBootFlag = DOWNLOAD_REQUESTED;
		Cnt_ResetDelay = 0;
		ECU_Reset_Bit = 1;
		fBootWriteRequest = 1;
	}
	
	else
	{
		eUdsStatus = UDS_NRC_13;
	}
	
	return eUdsStatus;
}


/*--------------------------{end EraeMemoryTest}----------------------------------*/

