ubyte	ubFingerprint[12];
/*--------------------------{RDBI_FingerPrint}--------------------------------------*/
/* Deviation MISRA-1 */
tUdsStatus RDBI_FingerPrint(u16 *puwLen, u8 *aubUdsData)
{
	ubyte i,x,temp;
	uword	WriteData;
  /* Define pointer to length in callback */
  /* If nothing is implemented in callback, length returned is 0 and no response is sent */
  /* By default the callback length shall be 3 (service 1 and DID 2 ) */
  
  tUdsStatus eUdsStatus;
  
  /* input pointers are always checked in case of function takes NULL parameters */
  if ((puwLen != NULL) && (aubUdsData != NULL))
  {
    *puwLen = 15U;
		for(x=0,i=0;i<12;i++)
		{
			temp = i % 2;
			if(!temp)
			{
				WriteData = SPI_EEP_Read_X16((Fingerprint_AddOffset + x));
				ubFingerprint[i] = (ubyte)(WriteData >> 8);
				ubFingerprint[i+1] = (ubyte)WriteData;
				++x;
			}

			aubUdsData[3+i] = ubFingerprint[i];
		}
		eUdsStatus = UDS_ACK;
  }
  else
  {
      eUdsStatus = UDS_NRC_13;					// Incorrect Message Length or Invalid Format
  }

    return eUdsStatus;
}
/*--------------------------{end RDBI_FingerPrint}----------------------------------*/

/*--------------------------{WDBI_WriteFingerPrint}--------------------------------------*/
/* Deviation MISRA-1 */
tUdsStatus WDBI_WriteFingerPrint(u16 *puwLen, u8 *aubUdsData)
{
	ubyte i,x,temp;
	uword WriteData;

  /* Define pointer to length in callback */
  /* If nothing is implemented in callback, length returned is 0 and no response is sent */
  /* By default the callback length shall be 3 (service 1 and DID 2 ) */
  
  tUdsStatus eUdsStatus;
  
  /* input pointers are always checked in case of function takes NULL parameters */
  if ((puwLen != NULL) && (aubUdsData != NULL))
  {
  	if(m_eSecurityState == PROG_SECURITY_STATE_UNLOCK)
  	{
      *puwLen = 3U;

			for(i=0,x=0;i<12;i++)
			{
				ubFingerprint[i] = aubUdsData[3+i];
			}

			fFingerPrintWrote = 1;
			eUdsStatus = UDS_NRC_78;
  	}
		else
		{
			eUdsStatus = UDS_NRC_7F;					// Security Acces Denied
		}
  }
  else
  {
      eUdsStatus = UDS_NRC_13;					// Incorrect Message Length or Invalid Format
  }
	
	return eUdsStatus;
}
/*--------------------------{end WDBI_WriteFingerPrint}----------------------------------*/

/*--------------------------{IOCBI_AudibleChimeReq}--------------------------------------*/
/* Deviation MISRA-1 */
tUdsStatus IOCBI_AudibleChimeReq(u16 *puwLen, u8 *aubUdsData)
{
    /* Define pointer to length in callback */
    /* If nothing is implemented in callback, length returned is 0 and no response is sent */
    /* By default the callback length shall be 3 (service 1 and DID 2 ) */
    
    tUdsStatus eUdsStatus;

		eUdsStatus = UDS_ACK;
    /* input pointers are always checked in case of function takes NULL parameters */
    if ((puwLen != NULL) && (aubUdsData != NULL))
    {
    	if(m_eSecurityState == PROG_SECURITY_STATE_UNLOCK)
    	{
				*puwLen = 5U;
	    	if(aubUdsData[3] == 0)
	    	{
					IOCBI_AudibleChimeReq_Bit = 1;
					if(IOCBI_AudibleChimeControl_Bit)
					{
						IOCBI_AudibleChimeControl_Bit = 0;
						aubUdsData[4] = 0;
					}
					else
					{
						IOCBI_AudibleChimeControl_Bit = 1;
						aubUdsData[4] = 1;
					}
	    	}
				else if(aubUdsData[3] == 3)
				{
					IOCBI_AudibleChimeReq_Bit = 1;
					
					if(aubUdsData[4] == 1)
					{
						IOCBI_AudibleChimeControl_Bit = 1;
					}
					else if(aubUdsData[4] == 0)
					{
						IOCBI_AudibleChimeControl_Bit = 0;
					}
					else
					{
						IOCBI_AudibleChimeReq_Bit = 0;
						eUdsStatus = UDS_NRC_13;				// Incorrect Message Length or Invalid Format
					}
				}
				else
				{
					IOCBI_AudibleChimeReq_Bit = 0;
					eUdsStatus = UDS_NRC_13;				// Incorrect Message Length or Invalid Format
				}
    	}
			else
			{
				eUdsStatus = UDS_NRC_33;					// Security Acces Denied
			}
    }
    else
    {
        eUdsStatus = UDS_NRC_13;					// Incorrect Message Length or Invalid Format
    }

    return eUdsStatus;
}
/*--------------------------{end IOCBI_AudibleChimeReq}----------------------------------*/

/*--------------------------{IOCBI_BreakLightReq}--------------------------------------*/
/* Deviation MISRA-1 */
tUdsStatus IOCBI_BreakLightReq(u16 *puwLen, u8 *aubUdsData)
{
    /* Define pointer to length in callback */
    /* If nothing is implemented in callback, length returned is 0 and no response is sent */
    /* By default the callback length shall be 3 (service 1 and DID 2 ) */
    
    tUdsStatus eUdsStatus;
    eUdsStatus = UDS_ACK;
    /* input pointers are always checked in case of function takes NULL parameters */
    if ((puwLen != NULL) && (aubUdsData != NULL))
    {
			if(m_eSecurityState == PROG_SECURITY_STATE_UNLOCK)
    	{
				*puwLen = 5U;
				if(aubUdsData[3] == 0)
				{																					// Return Control
					IOCBI_BrakLightReq_Bit = 1;
					if(IOCBI_BreakLightReqControl_Bit)
					{
						aubUdsData[4] = 0;
						IOCBI_BreakLightReqControl_Bit = 0;
					}
					else
					{
						IOCBI_BreakLightReqControl_Bit = 1;
						aubUdsData[4] = 1;
					}
	    	}
				else if(aubUdsData[3] == 3)
				{																					// request Control
					IOCBI_BrakLightReq_Bit = 1;
					
					if(aubUdsData[4] == 1)
					{
						IOCBI_BreakLightReqControl_Bit = 1;
					}
					else
					{
						IOCBI_BreakLightReqControl_Bit = 0;
					}
				}
				else
				{
					IOCBI_BrakLightReq_Bit = 0;
					eUdsStatus = UDS_NRC_22;				// Conditions not correct
				}
			}
			else
			{
				eUdsStatus = UDS_NRC_33;					// Security Acces Denied
			}
    }
    else
    {
        eUdsStatus = UDS_NRC_13;					// Incorrect Message Length or Invalid Format
    }

    return eUdsStatus;
}
/*--------------------------{end IOCBI_BreakLightReq}----------------------------------*/

